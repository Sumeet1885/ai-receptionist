# Subdomain: test.ai-receptionist.agilewaters.com
# Caddy auto-provisions and renews a Let's Encrypt TLS cert automatically.
# No certbot or nginx config needed - just make sure port 80 and 443 are
# open in your EC2 Security Group and the DNS A record points to your EC2 IP.

{$APP_DOMAIN:test.ai-receptionist.agilewaters.com}, {$API_DOMAIN:test.ai-receptionist.agilewaters.com} {

    # All /api/* requests → Express backend (api service on port 4000)
    handle /api/* {
        reverse_proxy api:4000
    }

    # All /widget/* requests → Express backend (api service on port 4000)
    handle /widget/* {
        reverse_proxy api:4000
    }

    # Everything else → Vite-built React SPA
    handle {
        root * /srv
        encode gzip
        try_files {path} /index.html
        file_server
    }
}
