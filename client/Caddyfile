# Caddy auto-provisions and renews Let's Encrypt TLS certs automatically.
# Domains are injected dynamically via APP_DOMAIN and API_DOMAIN environment variables.

{$APP_DOMAIN}, {$API_DOMAIN} {

    # All /api/* requests → Express backend (api service on port 4000)
    handle /api/* {
        reverse_proxy api:4000
    }

    # All /widget/* requests → Express backend (api service on port 4000)
    handle /widget/* {
        reverse_proxy api:4000
    }

    # Everything else → Vite-built React SPA
    handle {
        root * /srv
        encode gzip
        try_files {path} /index.html
        file_server
    }
}
