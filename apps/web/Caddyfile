# Caddy auto-provisions and renews Let's Encrypt TLS certs automatically.
# Domains are injected dynamically via APP_DOMAIN and API_DOMAIN environment variables.

{$APP_DOMAIN}, {$API_DOMAIN} {

    # All /api/* requests → Express backend (api service on port 4000)
    handle /api/* {
        reverse_proxy api:4000
    }

    # All /widget/* requests → Express backend (api service on port 4000)
    handle /widget/* {
        reverse_proxy api:4000
    }

    # Admin console (apps/admin, built into /srv/super-admin). Its API calls go to /api/admin/*
    # through the /api/* rule above, so it is same-origin with the API.
    handle /super-admin* {
        header X-Robots-Tag "noindex, nofollow"
        header X-Frame-Options "DENY"
        # Pages are never cached (fresh session state); hashed assets may be.
        @adminPage not path /super-admin/assets/*
        header @adminPage Cache-Control "no-store"
        root * /srv
        encode gzip
        try_files {path} /super-admin/index.html
        file_server
    }

    # Everything else → Vite-built React SPA
    handle {
        root * /srv
        encode gzip
        try_files {path} /index.html
        file_server
    }
}
