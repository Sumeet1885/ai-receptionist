# Local development: copy to apps/web/.env.local. Only VITE_* values exist here, and every one of
# them is public (Vite bakes them into the browser bundle). Never put secrets in this app.
# Staging/production values are baked in apps/web/Dockerfile.staging / Dockerfile.prod.

# Same Supabase project as apps/api/.env (Project URL without /rest/v1, and the publishable key).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the API runs (REST, live voice WebSocket, embeddable widget).
VITE_EXPRESS_SERVER_URL=http://localhost:4000
VITE_WIDGET_BASE_URL=http://localhost:4000

# Cloudflare Turnstile site key for the public forms (leave empty locally to skip the widget).
VITE_TURNSTILE_SITE_KEY=

# Public SEO origin; use the final canonical production domain.
VITE_SITE_URL=https://your-public-website.example
# Set false for staging/preview builds. Local dev is always noindex.
VITE_INDEXABLE=false
