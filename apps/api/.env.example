# Local development: copy to apps/api/.env. On the EC2 instance: copy to server/.env (the path
# docker-compose-*.yml reads on the host) and fill in. docker-compose.yml's api service loads
# this file directly (env_file:) - this is the one place all backend secrets live.

# Environment: 'development' (default, reads secrets from .env) | 'staging' | 'production'
# On staging/production servers set this to match the environment so loadSecrets pulls from
# the correct SSM namespace: /ai-receptionist/{DEPLOY_ENV}/{PARAM_NAME}
DEPLOY_ENV=development
AWS_REGION=ap-south-1

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Calendar OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/calendar/callback/google

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.yourdomain.com/api/calendar/callback/outlook

# Server URLs - same two domains as the root .env's APP_DOMAIN/API_DOMAIN, just with the scheme.
PORT=4000
CLIENT_URL=https://app.yourdomain.com
EXPRESS_SERVER_URL=https://api.yourdomain.com
WIDGET_BASE_URL=https://api.yourdomain.com

# Public endpoint protection.
ALLOW_ALL_WIDGET_DOMAINS=false
WIDGET_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=60
LIVE_VOICE_RATE_LIMIT_PER_MINUTE=20

# Dograh phone calls (inbound + outbound). Optional - the phone-calls module stays inert (no
# routes, no poller) when these are unset. See docs/phone-calls.md for the feature overview
# and docs/01_CONFIGURE_DOGRAH.md for setup instructions.
DOGRAH_API_URL=http://YOUR_DOGRAH_EC2_PUBLIC_IP:8000
DOGRAH_API_KEY=
DOGRAH_POLL_INTERVAL_MS=60000

# Lets Dograh's server call back into this one mid-call for calendar tools (check_availability/
# book_appointment) and pre-call session creation. PHONE_TOOLS_API_KEY is a secret you generate
# yourself (e.g. `openssl rand -hex 24`) - it just has to match what dograhController.ts sends
# Dograh when it creates the tools, which happens automatically on "Provision phone agent".
PHONE_TOOLS_API_KEY=
PHONE_TOOLS_CALLBACK_BASE_URL=https://api.yourdomain.com

# Staff console (apps/admin). Exact origin the console is served from; /api/admin rejects
# state-changing requests from any other origin. Accounts: npm run staff:create -w apps/api.
ADMIN_ORIGIN=https://admin.yourdomain.com

# Logs go to stdout as JSON; in staging/production Docker's awslogs driver ships them to
# CloudWatch (see docker-compose-*.yml). No in-process CloudWatch settings are needed.

