# Root .env - read by `docker compose build`/`up` for the two domains Caddy serves and the
# values Vite needs baked into the frontend build (see docker-compose.yml's web.build.args).
# Copy to .env and fill in. Backend secrets do NOT go here - they go in server/.env, loaded via
# docker-compose.yml's `env_file:` on the api service. See docs/AWS_DEPLOYMENT.md and
# docs/setup.md for the full walkthrough.

APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_EXPRESS_SERVER_URL=https://api.yourdomain.com
VITE_WIDGET_BASE_URL=https://api.yourdomain.com

# ---------------------------------------------------------------------------------------------
# Everything below this line is a REFERENCE for server/.env's contents, not part of this file.
# Copy server/.env.example (if present) or this block into server/.env on the EC2 instance.
# ---------------------------------------------------------------------------------------------

# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
#
# # Calendar OAuth.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/calendar/callback/google
#
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://api.yourdomain.com/api/calendar/callback/outlook
#
# # Server URLs.
# PORT=4000
# CLIENT_URL=https://app.yourdomain.com
# EXPRESS_SERVER_URL=https://api.yourdomain.com
# WIDGET_BASE_URL=https://api.yourdomain.com
#
# # Public endpoint protection.
# ALLOW_ALL_WIDGET_DOMAINS=false
# WIDGET_RATE_LIMIT_PER_MINUTE=120
# CHAT_RATE_LIMIT_PER_MINUTE=60
# LIVE_VOICE_RATE_LIMIT_PER_MINUTE=20
#
# # Dograh phone calls (inbound + outbound). Optional - the phone-calls module stays inert (no
# # routes, no poller) when these are unset. See "Phone calls/README.md" for the feature overview
# # and docs/01_CONFIGURE_DOGRAH.md for how to get DOGRAH_EMAIL/DOGRAH_PASSWORD.
# DOGRAH_API_URL=http://YOUR_DOGRAH_EC2_PUBLIC_IP:8000
# DOGRAH_EMAIL=
# DOGRAH_PASSWORD=
# DOGRAH_POLL_INTERVAL_MS=60000
#
# # Lets Dograh's server call back into this one mid-call for calendar tools (check_availability/
# # book_appointment) and pre-call session creation. PHONE_TOOLS_API_KEY is a secret you generate
# # yourself (e.g. `openssl rand -hex 24`) - it just has to match between this file and what
# # dograhController.ts sends Dograh when creating the tools, which happens automatically.
# PHONE_TOOLS_API_KEY=
# PHONE_TOOLS_CALLBACK_BASE_URL=https://api.yourdomain.com
