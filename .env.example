# EC2 HOST ONLY: template for the .env next to docker-compose-staging.yml / docker-compose-prod.yml
# on the server (/home/ec2-user/ai-receptionist/.env). Local development does not use a root .env.
#
# Where every environment file lives:
#   apps/api/.env         API settings and all backend secrets   (template: apps/api/.env.example)
#   apps/web/.env.local   browser-safe VITE_* values for the web  (template: apps/web/.env.example)
#   apps/admin            no env file (the admin console only calls the API)
#   server/.env on EC2    the API's settings in staging/production (same keys as apps/api/.env.example)
#   .env on EC2           this file: domains and image tags for docker-compose
#
# Never put backend secrets here; they go in server/.env (or SSM) on the host.

# Domains Caddy serves and issues certificates for.
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com

# Image location and the tags to run; the release runbook updates the two tags on every deploy.
DOCKER_USERNAME=your-dockerhub-username
IMAGE_TAG_SERVER=ai-receptionist-server-staging-<sha7>
IMAGE_TAG_CLIENT=ai-receptionist-client-staging-<sha7>

# BACKEND SETUP (separate file; Docker loads ./server/.env, not this root file).
# On EC2, create the backend template alongside this file:
#   New-Item -ItemType Directory -Force server
#   Copy-Item apps/api/.env.example server/.env
# Or on Linux: mkdir -p server && cp apps/api/.env.example server/.env
# Fill in server/.env before starting Compose. Its complete template is apps/api/.env.example.
# Set DEPLOY_ENV=staging or production to match the deployment.
# Set CLIENT_URL and ADMIN_ORIGIN=https://<APP_DOMAIN> (admin is under /super-admin/).
# Set EXPRESS_SERVER_URL and WIDGET_BASE_URL=https://<API_DOMAIN>.
#
# Email + private support attachments: put these settings in server/.env:
#   AWS_REGION=ap-south-1
#   AWS_SES_REGION=ap-south-1
#   EMAIL_FROM=no-reply@your-verified-domain.com
#   EMAIL_FROM_NAME=Bolega India
#   EMAIL_REPLY_TO=
#   AUTH_LINK_EXPIRY_HOURS=1
#   S3_BUCKET_NAME=your-private-upload-bucket
#   AWS_S3_REGION=ap-south-1
# Staging/production use the EC2 instance role for SES and S3. Leave AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, AWS_SES_ROLE_ARN and AWS_S3_ROLE_ARN unset there.
# Role permissions: ses:SendEmail on the verified sender and s3:PutObject/GetObject/DeleteObject
# on arn:aws:s3:::<bucket>/ai-receptionist/support/*. Keep S3 public access blocked.
# For local development, configure AWS keys and AWS_SES_ROLE_ARN / AWS_S3_ROLE_ARN in
# apps/api/.env to assume the service role. Never copy development keys into this root file.
#
# Supabase, AI provider, OAuth, Turnstile and Razorpay secrets belong in server/.env or the
# supported SSM namespace /ai-receptionist/{staging|production}/. See apps/api/.env.example.
# TURNSTILE_SECRET_KEY is required for public forms outside development.
# Browser values (VITE_*) are supplied at web-image build time, not by this Compose .env:
# use apps/web/.env.example as the browser-safe template. Never expose backend secrets there.
