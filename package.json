{
  "name": "ai-receptionist-root",
  "private": true,
  "scripts": {
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:functions": "supabase functions serve --no-verify-jwt",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:functions\"",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "supabase": "^2.106.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
