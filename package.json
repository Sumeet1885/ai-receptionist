{
  "name": "ai-receptionist-root",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose --ui=stream --log-order=stream --log-prefix=task --output-logs=full --filter=@ai-receptionist/web --filter=@ai-receptionist/api",
    "dev:web": "turbo run dev --env-mode=loose --ui=stream --filter=@ai-receptionist/web",
    "dev:api": "turbo run dev --env-mode=loose --ui=stream --filter=@ai-receptionist/api",
    "dev:admin": "pnpm --filter @ai-receptionist/web dev",
    "dev:functions": "supabase functions serve --no-verify-jwt",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "turbo run typecheck build && pnpm run check:boundaries && turbo run test",
    "db:migrate": "supabase db push",
    "deploy:functions": "supabase functions deploy chat-reply && supabase functions deploy analyze-lead"
  },
  "devDependencies": {
    "supabase": "^2.106.0",
    "turbo": "2.5.4"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
