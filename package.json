{
  "name": "ai-receptionist-root",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.11 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --env-mode=loose --filter=@ai-receptionist/web --filter=@ai-receptionist/api",
    "dev:web": "turbo run dev --env-mode=loose --filter=@ai-receptionist/web",
    "dev:api": "turbo run dev --env-mode=loose --filter=@ai-receptionist/api",
    "dev:admin": "turbo run dev --env-mode=loose --filter=@ai-receptionist/admin",
    "dev:functions": "supabase functions serve --no-verify-jwt",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "turbo run typecheck build && npm run check:boundaries && turbo run test",
    "db:migrate": "supabase db push",
    "deploy:functions": "supabase functions deploy chat-reply && supabase functions deploy analyze-lead"
  },
  "devDependencies": {
    "supabase": "^2.106.0",
    "turbo": "2.5.4"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
